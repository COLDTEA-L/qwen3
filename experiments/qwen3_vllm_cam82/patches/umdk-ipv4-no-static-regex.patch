+// Keep IPv4 validation allocation-free: a global std::regex constructor can
+// fail while CAM is dlopened alongside the Torch/CANN C++ runtimes.
+// Match the previous rule, including decimal octets with leading zeroes.
+bool Ipv4IsValid(const std::string& ip) {
+    unsigned int dots = 0;
+    unsigned int value = 0;
+    unsigned int digits = 0;
+    for (const char ch : ip) {
+        if (ch >= '0' && ch <= '9') {
+            if (++digits > 3) {
+                return false;
+            }
+            value = value * 10 + static_cast<unsigned int>(ch - '0');
+            if (value > 255) {
+                return false;
+            }
+        } else if (ch == '.') {
+            if (digits == 0 || dots == 3) {
+                return false;
+            }
+            ++dots;
+            value = 0;
+            digits = 0;
+        } else {
+            return false;
+        }
+    }
+    return dots == 3 && digits != 0;
+}

