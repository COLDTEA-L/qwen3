+  exit 1
+fi
+echo "CAM82_OP_PACKAGE_INSTALLED ${cam_op_api}"
 export CAM_COMM_PATH="$source_dir"
 export CAM_COMM_BUILD_PATH="${output_dir}/comm-build"
 cd "${source_dir}/pybind"
