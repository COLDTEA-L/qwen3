@@ -23,7 +23,16 @@
   echo "Expected exactly one matching op package; inspect output/cam/comm_operator/run" >&2
   exit 1
 fi
-bash "${packages[0]}" --install
+# msopgen custom-op archives execute their installer directly, without --install.
+cam_install_opp="${CAM_OPP_INSTALL_PATH:-${ASCEND_OPP_PATH}}"
+bash "${packages[0]}" --quiet --nox11 --install-path="${cam_install_opp}"
+cam_op_api="${cam_install_opp}/vendors/CAM/op_api"
